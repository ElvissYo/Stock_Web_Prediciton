# Copy this file to .env and update values for your local Neo4j instance.
APP_ENV=local
LOG_LEVEL=INFO

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Optional RSS source override for scripts/collect_news.py.
# Format: Source Name|https://example.com/rss,Other Source|https://example.com/rss
NEWS_RSS_FEEDS=

# Optional API-based news collection.
# NEWS_API_PROVIDER can be rss, gdelt, or newsapi. gdelt does not need a key.
NEWS_API_PROVIDER=rss
NEWS_API_LANGUAGE=id
NEWSAPI_API_KEY=
